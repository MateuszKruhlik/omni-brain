# ==============================================================================
# OMNI BRAIN — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: .env is git-ignored and should NEVER be committed.
# ==============================================================================

# --- Embedding Provider ---
# Choose: "voyage" (default, recommended) or "openai"
EMBEDDING_PROVIDER=voyage

# --- API Keys (fill in at least one, depending on provider) ---
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- Optional Overrides ---
# CHROMA_DIR=rag/indexes/chroma
